// ---------- building blocks ----------

function Hen({
  x,
  y,
  s = 1,
  flip = false,
  body = "#FFFFFF",
  shade = "#DCE2D8",
  comb = "#D64545",
}) {
  // A flipped hen faces left and is drawn leftwards from x
  const tx = flip ? x + 116 * s : x;

  return (
    <g transform={`translate(${tx} ${y}) scale(${flip ? -s : s} ${s})`}>
      <ellipse cx="58" cy="107" rx="42" ry="6" fill="#000" opacity="0.14" />

      <g stroke="#E39A2D" strokeWidth="3.5" strokeLinecap="round" fill="none">
        <path d="M54 88 V103 M54 103 l-9 3 M54 103 l7 4" />
        <path d="M72 86 V103 M72 103 l-9 3 M72 103 l7 4" />
      </g>

      <path d="M22 56 C6 46 4 26 14 12 C18 30 28 38 38 46Z" fill={shade} />
      <path d="M24 60 C10 56 4 44 8 32 C16 44 26 48 36 52Z" fill={body} />
      <path
        d="M20 58 C20 38 44 32 66 36 C84 40 94 52 90 68 C86 84 64 92 44 90 C28 88 20 76 20 58Z"
        fill={body}
      />
      <path d="M36 58 C46 48 64 50 72 62 C64 76 46 78 36 68Z" fill={shade} />
      <ellipse cx="84" cy="46" rx="12" ry="17" fill={body} />
      <circle cx="90" cy="32" r="13" fill={body} />
      <path
        d="M82 22 C79 13 86 10 88 17 C90 9 97 10 96 19 C101 15 105 20 100 25Z"
        fill={comb}
      />
      <path d="M101 32 L113 36 L101 41Z" fill="#F0A22E" />
