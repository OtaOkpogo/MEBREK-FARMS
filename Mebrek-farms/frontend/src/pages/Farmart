}

function Seedling({ x, y, s = 1 }) {
  return (
    <g transform={`translate(${x} ${y}) scale(${s})`}>
      <path
        d="M0 0 C-2 -18 -2 -34 0 -48"
        stroke="#4F8A4B"
        strokeWidth="4"
        strokeLinecap="round"
        fill="none"
      />
      <path d="M0 -30 C-22 -34 -30 -50 -28 -62 C-10 -60 0 -48 0 -30Z" fill="#6FB06A" />
      <path d="M0 -40 C20 -46 30 -60 28 -72 C10 -70 0 -58 0 -40Z" fill="#8CC77F" />
