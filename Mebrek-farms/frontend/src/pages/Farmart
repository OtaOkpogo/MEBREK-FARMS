const ART = {
  hero: HeroArt,
  eggs: EggsArt,
  poultry: PoultryArt,
  manure: ManureArt,
};

// =========================================================
// FarmPhoto
// src  : your real photo (for example "/images/hero.jpg"), or "" for none
// art  : "hero" | "eggs" | "poultry" | "manure"
// =========================================================

export function FarmPhoto({
  src,
  art = "hero",
  alt,
  className = "",
  loading = "lazy",
}) {
  const [failed, setFailed] = useState(false);
  const Art = ART[art] || HeroArt;

  if (!src || failed) {
    return <Art alt={alt} className={className} />;
  }

  return (
    <img
      src={src}
      alt={alt}
      loading={loading}
      onError={() => setFailed(true)}
      className={className}
    />
  );
}