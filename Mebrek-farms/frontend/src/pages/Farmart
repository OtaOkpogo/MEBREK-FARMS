}

function Egg({ x, y, s = 1, rot = 0, fill = "#F1D9B2", shade = "#DDB985" }) {
  return (
    <g transform={`translate(${x} ${y}) rotate(${rot}) scale(${s})`}>
      <path
        d="M0 -26 C13 -26 20 -4 20 8 C20 21 11 28 0 28 C-11 28 -20 21 -20 8 C-20 -4 -13 -26 0 -26Z"
        fill={fill}
      />
      <path
        d="M-4 -20 C-13 -12 -16 0 -15 10"
        stroke="#fff"
        strokeWidth="3"
        strokeLinecap="round"
        opacity=".55"
        fill="none"
      />
      <path
        d="M8 24 C14 20 18 12 18 6"
        stroke={shade}
        strokeWidth="3"
        strokeLinecap="round"
        opacity=".6"
        fill="none"
