}

function Tufts({ points }) {
  return (
    <g fill="#2F6A3C" opacity=".55">
      {points.map(([x, y], i) => (
        <path key={i} d={`M${x} ${y} l-5 -16 l5 8 l4 -14 l3 14 l6 -8 l-4 16Z`} />
      ))}
    </g>
  );
}

